    70,
    "BACK",
    28,
    2,
    create_color(150, 150, 150, 255),
    create_color(29, 78, 216, 255),
    create_color(30, 58, 138, 255)
  )? {
    g_screen = g_c_screen_menu;
  }

  return true;
}

fu update_game(p_delta) {
  if g_dorg_dead? {
    return update_death_screen(p_delta);
  }
  return update_game_screen(p_delta);
}

fu music_update() {
  if g_music_state == g_c_music_menu? {
    update_music(g_c_project_32_1);
  } else if g_music_state == g_c_music_game? {
    update_music(g_current_music);
  } else if g_music_state == g_c_music_ballerina? {
    update_music(g_c_ballerina);
  }
}

// gets called every frame
glob fu update(p_delta) {
  g_elapsed = g_elapsed + p_delta;

  let mut result = true;

  if g_screen == g_c_screen_game? {
    result = update_game(p_delta);
  } else if g_screen == g_c_screen_settings? {
    result = update_settings_screen(p_delta);
  } else if g_screen == g_c_screen_credits? {
    result = update_credits_screen(p_delta);
  } else {
    result = update_menu_screen(p_delta);
  }

  if g_screen == g_c_screen_menu || g_screen == g_c_screen_settings || g_screen == g_c_screen_credits? {
    music_menu();
  } else if g_screen == g_c_screen_game? {
      if g_dorg_dead? {
      // keep whatever music was playing
      } else if g_wave_state == g_c_wave_state_ballerina? {
          music_ballerina();
        } else {
         music_game();
        }
    } else {
	music_none();
     }
  music_update();
  g_previous_screen = g_screen;

  if g_screen == g_c_screen_game and not g_dorg_dead? {
    let score_str = str_concat("SCORE: ", to_str_no_decimal(g_score));
    draw_text(
      g_c_font,
      score_str,
      20,
      20,
      0, 0, 0,
      28, 1,
      black
    );
  }

  if g_debug? {
    let mut fps = 0;
    if p_delta > 0? fps = 1/p_delta;
    let fps_str = str_concat("fps: ", to_str_no_decimal(fps));
    let fps_sz = measure_text(g_c_font, fps_str, 24, 1);

    draw_text(
      g_c_font,
      fps_str,
      g_c_arena_bound_x - vector2_x(fps_sz) - 20,
      20,
      0, 0, 0,
      24, 1,
      black
    );
  }

  return result;
}
// gets called on end
glob fu shutdown() {
}
