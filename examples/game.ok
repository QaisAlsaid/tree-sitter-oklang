fu debug_print(p_msg) {
  if g_debug? print p_msg;
}

fu exp(p_base, p_exp) {
  let mut res = 1;
  for let mut i = 0; i < p_exp; i = i + 1? {
    res = res * p_base;
  }
  return res;
}

fu min(p_first, p_second) {
  if p_second < p_first? return p_second;
  return p_first;
}

fu max(p_first, p_second) {
  if p_first < p_second? return p_second;
  return p_first;
}

fu clamp(p_val, p_min, p_max) {
  return max(p_min, min(p_val, p_max));
}

fu point_in_aabb(p_px, p_py, p_x, p_y, p_w, p_h) {
  let hw = p_w / 2;
  let hh = p_h / 2;
  return (p_px < p_x + hw) and (p_px > p_x - hw) and (p_py < p_y + hh) and (p_py > p_y - hh);
}

fu circles_collide(p_x1, p_y1, p_x2, p_y2, p_r1, p_r2) {
  return vector2_distance_sqr(create_vector2(p_x1, p_y1), create_vector2(p_x2, p_y2)) <= ((p_r1 + p_r2) * (p_r1 + p_r2));
}

fu load_game_texture(path) {
  let texture = load_texture(path);
  if texture == null? {
    let err = str_concat("failed to load: ", path);
    print err;
    set_error(err);
  }
  return texture;
}

fu load_game_music(path) {
  let music = load_music(path);
  if music == null? {
    let err = str_concat("failed to load: ", path);
    print err;
    set_error(err);
  }
  return music;
}

