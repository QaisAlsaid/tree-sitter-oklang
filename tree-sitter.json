{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "oklang",
      "camelcase": "OKLang",
      "title": "OKLang",
      "scope": "source.oklang",
      "file-types": [
        "ok",
        "OK",
        "Ok"
      ],
      "injection-regex": "^oklang$",
      "class-name": "TreeSitterOklang"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "OKLang grammer for tree-sitter",
    "authors": [
      {
        "name": "qais",
        "email": "qaisalsaid4@gmail.com",
        "url": "https://codeberg.page/qais"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/qais/tree-sitter-oklang",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": true
  }
}
